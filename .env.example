# Copy to apps/web/.env.local for Next.js (L4/L5).
# Copy server secrets to scripts/.env for ingest (L1). Never commit either file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server and ingest only. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Private R2 bucket for original MP4 + SRT (ingest downloads to data/work, then deletes).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bigboom
# Optional. Default is https://<accountid>.r2.cloudflarestorage.com
# R2_ENDPOINT=
